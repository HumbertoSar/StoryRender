# Chave da OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Modelo servido via OpenRouter (trocável sem mudar código)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Postgres da VPS, alcançado por túnel SSH:
#   ssh -N -L 5432:localhost:5432 root@<vps>
# Sem essa var, o agente usa checkpointer em memória (estado morre no restart).
DATABASE_URL=postgresql://storyrender:SENHA@localhost:5432/storyrender
